{
  "name": "casa3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.card.config.ts",
    "build:app": "vite build",
    "build:card": "vite build --config vite.card.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:artifact": "vite build --config vite.artifact.config.ts && node scripts/single-html.mjs"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "pdfjs-dist": "^4.10.38",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
